# Copia este archivo a .env y rellénalo. En desarrollo casi todo es opcional.

# --- Obligatorio en producción ---
SITE_URL=https://malos.es
# openssl rand -hex 32
SESSION_SECRET=
# Contraseña del panel /admin (larga: es la única llave del panel)
ADMIN_PASSWORD=

# --- Avisos push (sin ellas, la web funciona pero no manda avisos) ---
# Genera el par con: npx web-push generate-vapid-keys
# ¡No las cambies después! Si cambian, todas las suscripciones dejan de funcionar.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@malos.es

# --- Email de confirmación (sin SMTP, los enlaces salen en el log) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Malos <socios@malos.es>

# --- Opcional ---
# Entorno de pruebas: no se indexa, enseña una franja de aviso y, sin SMTP, muestra el enlace de confirmación en pantalla.
TEST_MODE=false
# Enlace de donaciones (Ko-fi, Buy Me a Coffee...). Vacío = no se muestra el bloque.
KOFI_URL=
# Enlace al repositorio público, sale en el pie.
REPO_URL=
# Cloudflare Turnstile (anti-bots en el alta). Vacío = desactivado.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Días entre cambios de jugador favorito
FAVORITE_COOLDOWN_DAYS=30
# Datos del responsable para la política de privacidad y el aviso legal
LEGAL_OWNER=
LEGAL_EMAIL=hola@malos.es

# --- Docker / PortLedger (solo en el servidor) ---
COMPOSE_PROJECT_NAME=malos-web
TUNNEL_NETWORK=malos-web-net
WEB_ALIAS=malos-web
